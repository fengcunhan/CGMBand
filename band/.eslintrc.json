{
  "root": true,
  "env": {
    "es6": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:ux/essential"
  ],
  "parserOptions": {
    "parser": "babel-eslint",
    "sourceType": "module",
    "ecmaFeatures": {
      "ecmaVersion": true,
      "jsx": true
    }
  },
  "globals": {
    "console": false,
    "setTimeout": false,
    "clearTimeout": false,
    "setInterval": false,
    "clearInterval": false
  },
  "rules": {
    "indent": [
      "warn",
      2
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "info",
          "warn",
          "error"
        ]
      }
    ],
    "no-unused-vars": "warn",
    "quotes": [
      "warn",
      "single",
      {
        "avoidEscape": true,
        "allowTemplateLiterals": true
      }
    ],
    "linebreak-style": [
      "warn",
      "unix"
    ],
    "semi": [
      "warn",
      "never"
    ]
  },
  "overrides": [
    {
      "files": [
        "test/**/*.js",
        "tools/**/*.js"
      ],
      "env": {
        "node": true
      }
    }
  ]
}
