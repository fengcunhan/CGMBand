<template>
  <div class="page">
    <!-- History chart card. Everything inside is absolutely positioned from
         lib/chart.js (no canvas on Vela JS: the line is made of small divs). -->
    <div class="card">
      <div
        class="plot"
        style="left: {{chart.plot.left}}px; top: {{chart.plot.top}}px; width: {{chart.plot.width}}px; height: {{chart.plot.height}}px"
      >
        <div
          class="band"
          style="top: {{chart.band.top}}px; width: {{chart.plot.width}}px; height: {{chart.band.height}}px"
        ></div>
        <div
          class="grid-line"
          for="{{chart.grid}}"
          tid="id"
          style="top: {{$item.top}}px; width: {{chart.plot.width}}px"
        ></div>
        <div
          class="piece"
          for="{{chart.pieces}}"
          tid="id"
          style="left: {{$item.l}}px; top: {{$item.t}}px; width: {{$item.w}}px; height: {{$item.h}}px; background-color: {{$item.c}}"
        ></div>
        <div
          if="{{chart.hasDot}}"
          class="dot"
          style="left: {{chart.dot.left}}px; top: {{chart.dot.top}}px; width: {{chart.dot.size}}px; height: {{chart.dot.size}}px; border-radius: {{chart.dot.radius}}px; background-color: {{chart.dot.color}}; border-color: {{chart.dot.color}}"
        ></div>
      </div>
      <text
        class="range-label"
        style="left: {{chart.labels.high.left}}px; top: {{chart.labels.high.top}}px; width: {{chart.labelWidth}}px; height: {{chart.labelHeight}}px; color: {{chart.labels.high.color}}"
      >{{chart.labels.high.text}}</text>
      <text
        class="range-label"
        style="left: {{chart.labels.low.left}}px; top: {{chart.labels.low.top}}px; width: {{chart.labelWidth}}px; height: {{chart.labelHeight}}px; color: {{chart.labels.low.color}}"
      >{{chart.labels.low.text}}</text>
      <text
        class="time-label"
        for="{{chart.times}}"
        tid="id"
        style="left: {{$item.left}}px; top: {{chart.timeTop}}px; width: {{chart.timeWidth}}px; text-align: {{$item.align}}"
      >{{$item.text}}</text>
      <text if="{{chart.empty}}" class="empty">暂无历史数据</text>
    </div>

    <!-- Current glucose. -->
    <div class="current">
      <div class="label-row">
        <div class="link-dot" style="background-color: {{view.linkDotColor}}; border-color: {{view.linkDotColor}}"></div>
        <text class="label">当前血糖</text>
      </div>
      <div class="value-row">
        <text class="value" style="color: {{view.valueColor}}; font-size: {{view.valueFontSize}}px">{{view.valueText}}</text>
        <div class="side">
          <image
            if="{{view.trendIcon}}"
            class="trend"
            src="{{view.trendIcon}}"
            style="opacity: {{view.trendOpacity}}"
          ></image>
          <text class="unit">{{view.unitText}}</text>
        </div>
      </div>
      <text class="sub">{{view.subText}}</text>
    </div>
  </div>
</template>

<script>
import { REFRESH_INTERVAL_MS } from '../../lib/constants.js'
import { chartKey, sameChartKey } from '../../lib/chart-cache.js'
import { buildChart } from '../../lib/chart.js'
import { attachLink } from '../../lib/link.js'
import {
  initialPageState,
  storedHistory,
  withCachedHistory,
  withCachedReading,
  withLink,
  withLiveHistory,
  withLiveReading
} from '../../lib/page-state.js'
import { MESSAGE_TYPE, decodeMessage } from '../../lib/protocol.js'
import { loadHistory, loadReading, saveHistory, saveReading } from '../../lib/store.js'
import { buildView } from '../../lib/view.js'

function renderView(pageState, now) {
  return buildView(pageState.reading, pageState.range, now, pageState.link)
}

function renderChart(key, now) {
  return buildChart(key.history, key.range, key.unit, now)
}

const INITIAL_STATE = initialPageState()
const INITIAL_NOW = Date.now()

export default {
  // Only `view` and `chart` are reactive. Page state lives in plain fields
  // and is replaced (never mutated) through the pure page-state functions.
  private: {
    view: renderView(INITIAL_STATE, INITIAL_NOW),
    chart: renderChart(chartKey(INITIAL_STATE, INITIAL_NOW, REFRESH_INTERVAL_MS), INITIAL_NOW)
  },

  onInit() {
    this.destroyed = false
    this.timerId = null
    this.chartKey = null
    this.pageState = initialPageState()
    this.channel = attachLink({
      onMessage: (raw) => this.handleMessage(raw),
      onLinkChange: (link) => this.applyState(withLink(this.pageState, link)),
      onOpen: () => this.channel && this.channel.requestSync()
    })
    loadReading((cached) => this.applyState(withCachedReading(this.pageState, cached)))
    loadHistory((cached) => this.applyState(withCachedHistory(this.pageState, cached)))
  },

  onShow() {
    this.refreshView()
    this.startTicker()
    this.channel.refreshState()
    this.channel.requestSync()
  },

  onHide() {
    this.stopTicker()
  },

  onDestroy() {
    this.destroyed = true
    this.stopTicker()
    this.channel.detach()
  },

  handleMessage(raw) {
    const message = decodeMessage(raw)
    if (!message) {
      return
    }
    if (message.kind === MESSAGE_TYPE.BG) {
      const result = withLiveReading(this.pageState, message.reading)
      if (result.persist) {
        saveReading(result.state.reading)
      }
      this.applyState(result.state)
      return
    }
    const result = withLiveHistory(this.pageState, message.history)
    if (result.persist) {
      saveHistory(storedHistory(result.state))
    }
    this.applyState(result.state)
  },

  applyState(nextState) {
    if (this.destroyed || nextState === this.pageState) {
      return
    }
    this.pageState = nextState
    this.refreshView()
  },

  refreshView() {
    if (this.destroyed) {
      return
    }
    const now = Date.now()
    this.view = renderView(this.pageState, now)
    // Rebuild the ~100 chart divs only when history/range/unit change or the
    // x axis moves to the next refresh interval.
    const key = chartKey(this.pageState, now, REFRESH_INTERVAL_MS)
    if (!sameChartKey(key, this.chartKey)) {
      this.chartKey = key
      this.chart = renderChart(key, now)
    }
  },

  tick() {
    this.refreshView()
    this.channel.refreshState()
  },

  startTicker() {
    this.stopTicker()
    this.timerId = setInterval(() => this.tick(), REFRESH_INTERVAL_MS)
  },

  stopTicker() {
    if (this.timerId !== null) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  }
}
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

/* Chart card: 312x208 at a 12px inset (inner geometry: lib/chart-layout.js). */
.card {
  width: 312px;
  height: 208px;
  margin-top: 12px;
  border-radius: 24px;
  border-width: 1px;
  border-color: #1a1d23;
  background-color: #1a1d23;
}

.plot {
  position: absolute;
}

.band {
  position: absolute;
  left: 0px;
  background-color: #1c2626;
}

.grid-line {
  position: absolute;
  left: 0px;
  height: 1px;
  background-color: #2a2e35;
}

.piece {
  position: absolute;
}

.dot {
  position: absolute;
  border-width: 1px;
}

.range-label {
  position: absolute;
  font-size: 18px;
  lines: 1;
}

.time-label {
  position: absolute;
  height: 22px;
  font-size: 18px;
  color: #9ca3af;
  lines: 1;
}

.empty {
  position: absolute;
  left: 0px;
  top: 76px;
  width: 312px;
  height: 32px;
  font-size: 24px;
  color: #9ca3af;
  text-align: center;
}

/* Current glucose. */
.current {
  flex: 1;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.label-row {
  flex-direction: row;
  align-items: center;
}

.link-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  border-width: 1px;
  margin-right: 8px;
}

.label {
  font-size: 22px;
  color: #9ca3af;
}

.value-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.value {
  font-size: 120px;
  font-weight: bold;
  lines: 1;
}

.side {
  margin-left: 10px;
  flex-direction: column;
  align-items: center;
}

.trend {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.unit {
  margin-top: 4px;
  font-size: 20px;
  color: #9ca3af;
}

.sub {
  font-size: 24px;
  color: #9ca3af;
  lines: 1;
}
</style>
