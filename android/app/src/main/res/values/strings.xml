    <!-- Settings: fingerstick meter -->
    <string name="section_meter">指尖血糖仪</string>
    <string name="footer_meter">支持罗氏卓越金采 Connect、智航、逸智、智航觅等标准蓝牙血糖仪，协议与「轻糖生活」小程序相同。绑定时让血糖仪进入配对模式并放在手机旁，系统弹出配对请求时输入血糖仪上的 6 位配对码，具体按键操作见血糖仪说明书。血糖仪时间需与手机一致。指尖血糖以红色圆圈显示在主页曲线上，可标记采血时间点，不推送到手环。</string>
