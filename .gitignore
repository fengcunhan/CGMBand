# signing material — never commit
keystore/
band/sign/
*.jks
*.p12
*.pem

# android
# Xiaomi wearable SDK: fetched from Xiaomi's CDN by tools/fetch_xms_sdk.sh, not redistributed
android/app/libs/*.aar
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml

# band (vela); aiot-toolkit stages the project, including signing PEMs, in ../.temp_band during builds
.temp_band/
band/node_modules/
band/build/
band/dist/

.DS_Store

# release artifacts
out/

# macOS app: build output and local screenshots (may contain real readings)
macos/*.app/
macos/.build/
